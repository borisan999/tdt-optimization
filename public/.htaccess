RewriteEngine On

# Use simple rewrite rules without hardcoded base path
# to support both root and subfolder access

# 1. Allow existing static assets to be served directly (css, js, images)
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} !\.php$
RewriteRule ^ - [L]

# 2. If it's a real file (like export_input_excel.php), serve it directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 3. Route everything else to index.php
RewriteRule ^ index.php [QSA,L]
